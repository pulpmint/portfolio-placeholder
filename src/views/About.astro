---
import Greetings from "@/components/Greetings.astro";
import Heading from "@/components/Heading.astro";
import Link from "@/components/Link.astro";

import { DESC, HASHNODE, PIXEL_PERFECT } from "@/constants/data";
---

<section>
  <Heading>👤 ABOUT</Heading>

  <Greetings />
  <p>{DESC}</p>
  <p>{PIXEL_PERFECT}</p>

  <Link isExternal href={HASHNODE.LINK}>
    {HASHNODE.OPTIONAL}
  </Link>
</section>
