---
import Heading from "@/components/Heading.astro";
import Link from "@/components/Link.astro";

import {
  DESC,
  DESIGN_DEV,
  GREETINGS,
  HASHNODE,
  PIXEL_PERFECT
} from "@/constants/data";
---

<section>
  <Heading>👤 ABOUT</Heading>

  <p>{GREETINGS} {DESC}</p>
  <p>{PIXEL_PERFECT}</p>
  <p>{DESIGN_DEV}</p>

  <Link isExternal href={HASHNODE.LINK}>
    {HASHNODE.OPTIONAL}
  </Link>
</section>
