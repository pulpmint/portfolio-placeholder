---
import { GREETINGS } from "@/constants/data";
---

<p>
  <span></span>
  <strong>{GREETINGS}</strong>
</p>

<script>
  const getGreetings = () => {
    const hour = new Date().getHours();
    const suffix = "Anywho.";

    switch (true) {
      case hour >= 5 && hour < 12:
        return `🐼 Morning, rise and shine, have a good day ahead! ${suffix}`;
      case hour >= 12 && hour < 17:
        return `🍜 Afternoon, hope you had a good lunch or brunch! ${suffix}`;
      case hour >= 17 && hour < 21:
        return `🍵 Evening, hope you had your coffee or chai-sutta! ${suffix}`;
      case (hour >= 21 && hour < 24) || (hour >= 0 && hour < 5):
        return `🦉 Oooh, it's late, someone's a night owl! ${suffix}`;
      default:
        return "👋 Hello there!";
    }
  };

  document.getElementsByTagName("span")[0].innerHTML = getGreetings();
</script>
